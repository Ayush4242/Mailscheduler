datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String?
  name             String?
  avatarUrl        String?
  googleId         String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  campaigns        EmailCampaign[]
  scheduledEmails  ScheduledEmail[]
  senderAccounts   SenderAccount[]
  slackIntegration SlackIntegration?

  @@index([email])
}

model SenderAccount {
  id              String            @id @default(uuid())
  userId          String
  email           String
  name            String?
  hourlyLimit     Int               @default(100)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEmails ScheduledEmail[]

  @@unique([userId, email])
}

model EmailCampaign {
  id              String            @id @default(uuid())
  userId          String
  title           String
  subject         String
  body            String
  totalRecipients Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEmails ScheduledEmail[]

  @@index([userId])
}

model ScheduledEmail {
  id                 String         @id @default(uuid())
  userId             String
  campaignId         String?
  senderAccountId    String?
  recipient          String
  subject            String
  body               String
  status             EmailStatus    @default(SCHEDULED)
  scheduledAt        DateTime
  sentAt             DateTime?
  attemptCount       Int            @default(0)
  errorMessage       String?
  etherealPreviewUrl String?
  messageId          String?
  idempotencyKey     String         @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign           EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  senderAccount      SenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([scheduledAt, status])
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  teamId      String
  teamName    String?
  channelId   String?
  channelName String?
  accessToken String
  botUserId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
