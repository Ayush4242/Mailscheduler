# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long

# ==========================================
# Database (PostgreSQL & Prisma)
# Replace YOUR_PASSWORD with your local postgres password
# ==========================================
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/reachinbox"

# ==========================================
# Redis & BullMQ
# Local Redis (port 6379) or hosted Redis (e.g. Upstash, Aiven)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Elasticsearch
# Local (port 9200) or cloud instance (e.g. Elastic Cloud)
# ==========================================
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_API_KEY=

# ==========================================
# Worker, Concurrency & Rate Limiting
# ==========================================
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# ==========================================
# Email Delivery (Ethereal SMTP)
# Leave blank to automatically create dynamic test account via Nodemailer
# ==========================================
ETHEREAL_USER=
ETHEREAL_PASS=

# ==========================================
# Google OAuth 2.0
# Obtain from Google Cloud Console -> APIs & Credentials
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ==========================================
# Slack OAuth & Notifications
# Obtain from Slack API App Settings
# ==========================================
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback
